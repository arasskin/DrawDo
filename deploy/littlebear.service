[Unit]
Description=Littlebear namespace cache
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=littlebear
Group=littlebear
WorkingDirectory=/var/lib/littlebear
ExecStart=/opt/littlebear/current/littlebear/core
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
StateDirectory=littlebear
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/littlebear
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
